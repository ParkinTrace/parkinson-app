# Firebase local emulators
.firebase/
firestore-debug.log
firestore-debug*.log
ui-debug.log
firebase-debug.log
database-debug.log

# NOTE: lib/firebase_options.dart IS tracked on purpose —
# Firebase client keys are public identifiers and the app won't run
# without it. Regenerate anytime via `flutterfire configure`.

# Raw research datasets (~180MB) + archives — documented downloads, not code
functions/data/tappy_dataset/*.zip
functions/data/tappy_dataset/keystrokes/
functions/data/tappy_dataset/users/
functions/data/neuroqwerty_dataset/*.zip
functions/data/neuroqwerty_dataset/nq/

# Trained model binaries — regenerable via functions/models/run_*.py
# (RF in ~15s; TabPFN needs its pinned env; finetune needs Colab GPU)
*.joblib
functions/models/colab/colab_bundle.zip

